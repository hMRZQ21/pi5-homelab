#!/usr/bin/env bash
# pi5-status: read-only health summary of the Pi -- host, thermals, repo, public mirror, containers.
# Changes nothing (no fetch, no index refresh, no writes), so it is safe to pre-approve as one exact command.
set -u
S=/opt/stacks
export GIT_OPTIONAL_LOCKS=0
row() { printf '%-8s %s\n' "$1" "$2"; }

row host "$(hostname) | $(uptime -p) | load $(cut -d' ' -f1-3 /proc/loadavg)"
t=$(vcgencmd measure_temp 2>/dev/null | cut -d= -f2); th=$(vcgencmd get_throttled 2>/dev/null | cut -d= -f2)
row hw "soc ${t:-?} | throttled ${th:-?} | mem $(free -h | awk '/^Mem:/{print $7" free of "$2}') | disk $(df -h / | awk 'NR==2{print $3" used of "$2}')"

# fan: the kernel's fan driver (hwmon "pwmfan") and its cooling device must both exist, otherwise the thermal zone has nothing to drive
# (seen once after a firmware update, when the fan stayed off). PI5_HWMON_DIR / PI5_THERMAL_DIR only exist so this can be tested.
hwd=${PI5_HWMON_DIR:-/sys/class/hwmon}; thd=${PI5_THERMAL_DIR:-/sys/class/thermal}
fh=""; for d in "$hwd"/hwmon*; do [ "$(cat "$d/name" 2>/dev/null)" = pwmfan ] && fh=$d; done
fc=""; for d in "$thd"/cooling_device*; do [ "$(cat "$d/type" 2>/dev/null)" = pwm-fan ] && fc=$d; done
if [ -n "$fh" ] && [ -n "$fc" ]; then
  lv=$(cat "$fc/cur_state" 2>/dev/null); rpm=$(cat "$fh/fan1_input" 2>/dev/null)
  tach="${rpm:-?} rpm"; [ "${lv:-0}" != 0 ] && [ "${rpm:-0}" = 0 ] && tach="tach reads 0 rpm"
  fan="pwmfan ok | level ${lv:-?}/$(cat "$fc/max_state" 2>/dev/null) | pwm $(cat "$fh/pwm1" 2>/dev/null) | $tach"
else
  fan="MISSING:$([ -z "$fh" ] && echo ' no pwmfan device')$([ -z "$fc" ] && echo ' no pwm-fan cooling device') (fan not under kernel control; check dtparam=cooling_fan=on in config.txt)"
fi
row fan "$fan"

head=$(git -C "$S" rev-parse --short HEAD)
gh=$(timeout 15 git -C "$S" ls-remote origin refs/heads/main 2>/dev/null | cut -c1-7)
row repo "HEAD $head \"$(git -C "$S" log -1 --format=%s | cut -c1-50)\" | GitHub main ${gh:-unreachable} | uncommitted $(git -C "$S" status --porcelain | wc -l)"

last=$(cut -c1-7 "$HOME/.pi5-sync-last" 2>/dev/null)
pub=$(timeout 15 git -C "$HOME/pi5-public" ls-remote origin refs/heads/master 2>/dev/null | cut -c1-7)
[ "$last" = "$head" ] && st=in-sync || st=BEHIND
row mirror "last synced ${last:-none} ($st) | public ${pub:-unreachable} | log: $(tail -n 1 "$HOME/pi5-sync.log" 2>/dev/null | cut -c1-60)"

if read -r bn _ bt < "$HOME/.pi5-backup-last" 2>/dev/null; then
  b="last pulled $bn, $(( ($(date +%s) - $(date -d "$bt" +%s)) / 3600 ))h ago"
else
  b="never pulled"
fi
# the archive carries the newest Immich dump: show its age, and flag it when the nightly dump job has stopped (PI5_DUMP_DIR only exists for testing)
d=$(ls -t "${PI5_DUMP_DIR:-/srv/immich/db-backups}"/immich-db-backup-*.sql.gz 2>/dev/null | head -1)
if [ -n "$d" ]; then
  dh=$(( ($(date +%s) - $(stat -c %Y "$d")) / 3600 )); ds="DB dump ${dh}h old"; [ "$dh" -gt 36 ] && ds="DB dump STALE (${dh}h old)"
else
  ds="DB dump NONE"
fi
row backup "$b | undropped on Pi $(find /tmp/pi5-backup -maxdepth 1 -name 'pi5-backup-*.tgz' 2>/dev/null | wc -l) | $ds"

echo containers:
docker ps -a --format '{{.Names}}|{{.Status}}' | sort | while IFS='|' read -r n s; do printf '  %-24s %s\n' "$n" "$s"; done
