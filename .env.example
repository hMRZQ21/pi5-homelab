# Copy to .env and fill in real values for your deployment.
# Never commit .env -- see .gitignore.

# --- Homepage ---
# Comma-separated host:port list Homepage will accept requests for.
HOMEPAGE_ALLOWED_HOSTS=192.168.1.100:3000,homepage.example.com:3000
# Used as {{HOMEPAGE_VAR_TAILNET_HOST}} in homepage/config/services.yaml.
HOMEPAGE_VAR_TAILNET_HOST=your-tailnet-hostname.example.ts.net

# --- Immich ---
IMMICH_VERSION=v3.1.0
UPLOAD_LOCATION=/srv/immich/library
DB_DATA_LOCATION=/srv/immich/postgres
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_DATABASE_NAME=immich
TZ=America/New_York